# ==============================================================================
# MVP ARENA - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the secrets.
# ==============================================================================

# Application URL (Base URL for reset links and squad invitations)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/playarena

# Authentication Secret (Used for signing athlete & admin JWT tokens)
AUTH_SECRET=your_super_secret_jwt_key_here

# Web Push Notification Keys (VAPID RFC 8292)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# WhatsApp Cloud API (Meta for Developers)
# Leave blank to use console logger simulation mode
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Email Dispatcher Configuration
EMAIL_FROM="MVP Arena <your-email@example.com>"

# Option A: SMTP (Gmail / Custom Host)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Option B: Resend API (https://resend.com)
RESEND_API_KEY=

# Option C: SendGrid API (https://sendgrid.com)
SENDGRID_API_KEY=

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
